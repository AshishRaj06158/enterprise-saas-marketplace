datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
}

enum LicenseStatus {
  ACTIVE
  REVOKED
}

model User {
  id          String     @id @default(cuid())
  name        String?
  email       String     @unique
  password    String
  role        Role       @default(CLIENT)
  companyName String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  licenses    License[]
  auditLogs   AuditLog[]

  @@map("users")
}

model System {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  tagline      String
  category     String
  overview     String
  priceINR     Int
  priceUSD     Int
  architecture String
  p99Latency   String
  throughput   String
  uptime       String    @default("99.98%")
  techStack    String[]
  isLive       Boolean   @default(true)
  features     Json?
  apiEndpoints Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  licenses     License[]

  @@map("systems")
}

model License {
  id        String        @id @default(cuid())
  key       String        @unique
  systemId  String
  userId    String?
  buildHash String
  status    LicenseStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  system    System        @relation(fields: [systemId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("licenses")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  ipAddress String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  productName String?
  budget      String?
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([productName])
  @@map("leads")
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int
  category  String   @default("General")
  comment   String
  userEmail String?
  createdAt DateTime @default(now())

  @@map("feedbacks")
}
